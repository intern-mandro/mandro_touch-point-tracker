<?xml version="1.0" encoding="utf-8"?>
<!--
  Tourch Tracker 런처 아이콘 배경 — 제도 용지.

  앱 라이트 테마의 종이색(PaperCream)을 그대로 쓴다. 런처에서 아이콘을 보고 앱을
  열었을 때 같은 바탕색이 이어지도록.

  마커 위치(39,39) (70,56) (49,73) 마다 옅은 색 번짐을 깔아 둔다 — 참고 이미지의
  부드러운 발광을 흉내 낸 것으로, 큰 크기(설정·스토어)에서만 눈에 띄고 48dp 에서는
  그냥 종이처럼 보인다. 전경의 마커 좌표와 반드시 같이 움직여야 한다.

  API 26 미만용 비트맵(mipmap-*dpi/ic_launcher.webp)은 scripts/gen_legacy_icons.py
  가 같은 좌표·색으로 다시 그린다. 여기 값을 바꾸면 그 스크립트도 같이 고치고
  다시 돌려야 한다. 번짐만은 방식이 달라(가우시안 블러 vs 선형 radial) 근사치다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 종이 바탕 — 위에서 아래로 아주 옅은 톤 차이 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#FFFFFDF8" />
                <item android:offset="1" android:color="#FFF6F1E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 초록 마커 클릭 발광 (39,39) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="39"
                android:centerY="39"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#402ECC71" />
                <item android:offset="1" android:color="#002ECC71" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 빨강 마커 클릭 발광 (70,56) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="70"
                android:centerY="56"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#40EE412D" />
                <item android:offset="1" android:color="#00EE412D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 파랑 마커 클릭 발광 (49,73) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="49"
                android:centerY="73"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#403287F0" />
                <item android:offset="1" android:color="#003287F0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
